digraph ERD {
  graph [rankdir=TB, splines=spline, nodesep=0.7, ranksep=1.1, bgcolor="#FFFFFF",
         fontname="Helvetica-Bold", fontsize=18, label="Automated Resume Analysis System - Core Entity-Relationship Diagram (Overview)\nCore Entities, Primary Keys, Foreign Keys & Relationships\n", labelloc=t, labeljust=l];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#64748B", penwidth=1.6, arrowhead=vee, arrowsize=0.85];

  subgraph cluster_identity {
    label="Identity, Authentication & Role Profiles";
    style="rounded,filled";
    color="#CBD5E1";
    fillcolor="#F8FAFC";
    fontsize=13;
    fontname="Helvetica-Bold";
    margin=14;

    users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#0F172A" align="center"><font color="#FFFFFF"><b>USERS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="bio"><font color="#0F172A"><b>bio</b></font></td><td align="left"><font color="#64748B">TEXT</font></td><td align="right"></td></tr><tr><td align="left" port="email"><font color="#0F172A"><b>email</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="fullname"><font color="#0F172A"><b>fullname</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="google_access_token"><font color="#0F172A"><b>google_access_token</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="google_credentials"><font color="#0F172A"><b>google_credentials</b></font></td><td align="left"><font color="#64748B">TEXT</font></td><td align="right"></td></tr><tr><td align="left" port="google_refresh_token"><font color="#0F172A"><b>google_refresh_token</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td colspan="3" align="center" bgcolor="#F1F5F9"><font color="#64748B"><i>... and 9 more columns</i></font></td></tr></table>>];
    candidates [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#0F172A" align="center"><font color="#FFFFFF"><b>CANDIDATES</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#DC2626"><b>PK, FK</b></font></td></tr><tr><td align="left" port="current_company"><font color="#0F172A"><b>current_company</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="current_job_title"><font color="#0F172A"><b>current_job_title</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="experience_years"><font color="#0F172A"><b>experience_years</b></font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"></td></tr><tr><td align="left" port="highest_degree"><font color="#0F172A"><b>highest_degree</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="resume_url"><font color="#0F172A"><b>resume_url</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="skills"><font color="#0F172A"><b>skills</b></font></td><td align="left"><font color="#64748B">JSON</font></td><td align="right"></td></tr><tr><td align="left" port="university"><font color="#0F172A"><b>university</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    hr_staffs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#0F172A" align="center"><font color="#FFFFFF"><b>HR_STAFFS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#DC2626"><b>PK, FK</b></font></td></tr><tr><td align="left" port="company_name"><font color="#0F172A"><b>company_name</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="department"><font color="#0F172A"><b>department</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="position"><font color="#0F172A"><b>position</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    admins [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#0F172A" align="center"><font color="#FFFFFF"><b>ADMINS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#DC2626"><b>PK, FK</b></font></td></tr><tr><td align="left" port="department"><font color="#0F172A"><b>department</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="governance_scope"><font color="#0F172A"><b>governance_scope</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="managed_region"><font color="#0F172A"><b>managed_region</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="position"><font color="#0F172A"><b>position</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    password_resets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#0F172A" align="center"><font color="#FFFFFF"><b>PASSWORD_RESETS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="email"><font color="#0F172A"><b>email</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="expires_at"><font color="#0F172A"><b>expires_at</b>*</font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="token"><font color="#0F172A"><b>token</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    audit_logs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#0F172A" align="center"><font color="#FFFFFF"><b>AUDIT_LOGS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="user_id"><font color="#0F172A"><b>user_id</b></font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="action"><font color="#0F172A"><b>action</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="created_at"><font color="#0F172A"><b>created_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="details"><font color="#0F172A"><b>details</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="ip_address"><font color="#0F172A"><b>ip_address</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="target"><font color="#0F172A"><b>target</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
  }

  subgraph cluster_jobs {
    label="Job Descriptions & Recruitment Setup";
    style="rounded,filled";
    color="#DDD6FE";
    fillcolor="#F5F3FF";
    fontsize=13;
    fontname="Helvetica-Bold";
    margin=14;

    job_descriptions [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#DDD6FE"><tr><td colspan="3" bgcolor="#4338CA" align="center"><font color="#FFFFFF"><b>JOB_DESCRIPTIONS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="certifications_requirements"><font color="#0F172A"><b>certifications_requirements</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="department"><font color="#0F172A"><b>department</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="description"><font color="#0F172A"><b>description</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="education_requirements"><font color="#0F172A"><b>education_requirements</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="experience_requirements"><font color="#0F172A"><b>experience_requirements</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="is_active"><font color="#0F172A"><b>is_active</b></font></td><td align="left"><font color="#64748B">BOOLEAN</font></td><td align="right"></td></tr><tr><td colspan="3" align="center" bgcolor="#F1F5F9"><font color="#64748B"><i>... and 6 more columns</i></font></td></tr></table>>];
    form_templates [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#DDD6FE"><tr><td colspan="3" bgcolor="#4338CA" align="center"><font color="#FFFFFF"><b>FORM_TEMPLATES</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="created_by"><font color="#0F172A"><b>created_by</b></font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="created_at"><font color="#0F172A"><b>created_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="description"><font color="#0F172A"><b>description</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="fields"><font color="#0F172A"><b>fields</b>*</font></td><td align="left"><font color="#64748B">JSON</font></td><td align="right"></td></tr><tr><td align="left" port="is_default"><font color="#0F172A"><b>is_default</b></font></td><td align="left"><font color="#64748B">BOOLEAN</font></td><td align="right"></td></tr><tr><td align="left" port="name"><font color="#0F172A"><b>name</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="updated_at"><font color="#0F172A"><b>updated_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr></table>>];
    shortlist_rosters [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#DDD6FE"><tr><td colspan="3" bgcolor="#4338CA" align="center"><font color="#FFFFFF"><b>SHORTLIST_ROSTERS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="job_id"><font color="#0F172A"><b>job_id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="created_at"><font color="#0F172A"><b>created_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="created_by"><font color="#0F172A"><b>created_by</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="is_archived"><font color="#0F172A"><b>is_archived</b></font></td><td align="left"><font color="#64748B">BOOLEAN</font></td><td align="right"></td></tr><tr><td align="left" port="name"><font color="#0F172A"><b>name</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="notes"><font color="#0F172A"><b>notes</b></font></td><td align="left"><font color="#64748B">TEXT</font></td><td align="right"></td></tr><tr><td align="left" port="updated_at"><font color="#0F172A"><b>updated_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr></table>>];
    shortlist_roster_items [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#DDD6FE"><tr><td colspan="3" bgcolor="#4338CA" align="center"><font color="#FFFFFF"><b>SHORTLIST_ROSTER_ITEMS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="application_id"><font color="#0F172A"><b>application_id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="roster_id"><font color="#0F172A"><b>roster_id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="added_at"><font color="#0F172A"><b>added_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="added_by"><font color="#0F172A"><b>added_by</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="stage"><font color="#0F172A"><b>stage</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="updated_at"><font color="#0F172A"><b>updated_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr></table>>];
  }

  subgraph cluster_applications {
