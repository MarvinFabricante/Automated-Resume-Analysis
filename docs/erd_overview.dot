    resumes [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#A7F3D0"><tr><td colspan="3" bgcolor="#065F46" align="center"><font color="#FFFFFF"><b>RESUMES</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="candidate_id"><font color="#0F172A"><b>candidate_id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="created_at"><font color="#0F172A"><b>created_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="file_url"><font color="#0F172A"><b>file_url</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="filename"><font color="#0F172A"><b>filename</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="parsed_data"><font color="#0F172A"><b>parsed_data</b></font></td><td align="left"><font color="#64748B">JSON</font></td><td align="right"></td></tr><tr><td align="left" port="updated_at"><font color="#0F172A"><b>updated_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr></table>>];
