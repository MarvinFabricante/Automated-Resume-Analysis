digraph ERD {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.2, bgcolor="#FFFFFF", fontname="Helvetica-Bold", fontsize=16, label="Automated Resume Analysis System - Entity-Relationship Diagram (ERD)\nGenerated from Live Production Database Schema\n", labelloc=t, labeljust=l];
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=8, color="#64748B", penwidth=1.5, arrowhead=vee, arrowsize=0.8];
  subgraph cluster_identity {
    label="Identity, Users & Profiles";
    style="rounded,filled";
    color="#CBD5E1";
    fillcolor="#F8FAFC";
    fontsize=13;
    fontname="Helvetica-Bold";
    margin=16;
    users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#1E293B" align="center"><font color="#FFFFFF"><b>USERS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="bio"><font color="#0F172A"><b>bio</b></font></td><td align="left"><font color="#64748B">TEXT</font></td><td align="right"></td></tr><tr><td align="left" port="email"><font color="#0F172A"><b>email</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="fullname"><font color="#0F172A"><b>fullname</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="google_access_token"><font color="#0F172A"><b>google_access_token</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="google_credentials"><font color="#0F172A"><b>google_credentials</b></font></td><td align="left"><font color="#64748B">TEXT</font></td><td align="right"></td></tr><tr><td align="left" port="google_refresh_token"><font color="#0F172A"><b>google_refresh_token</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="google_token_expiry"><font color="#0F172A"><b>google_token_expiry</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="is_archived"><font color="#0F172A"><b>is_archived</b></font></td><td align="left"><font color="#64748B">BOOLEAN</font></td><td align="right"></td></tr><tr><td align="left" port="is_online"><font color="#0F172A"><b>is_online</b></font></td><td align="left"><font color="#64748B">BOOLEAN</font></td><td align="right"></td></tr><tr><td align="left" port="last_active"><font color="#0F172A"><b>last_active</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="location"><font color="#0F172A"><b>location</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="password"><font color="#0F172A"><b>password</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="phone"><font color="#0F172A"><b>phone</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="profile_image_url"><font color="#0F172A"><b>profile_image_url</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="role"><font color="#0F172A"><b>role</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    candidates [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#1E293B" align="center"><font color="#FFFFFF"><b>CANDIDATES</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#DC2626"><b>PK, FK</b></font></td></tr><tr><td align="left" port="current_company"><font color="#0F172A"><b>current_company</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="current_job_title"><font color="#0F172A"><b>current_job_title</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="experience_years"><font color="#0F172A"><b>experience_years</b></font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"></td></tr><tr><td align="left" port="highest_degree"><font color="#0F172A"><b>highest_degree</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="resume_url"><font color="#0F172A"><b>resume_url</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="skills"><font color="#0F172A"><b>skills</b></font></td><td align="left"><font color="#64748B">JSON</font></td><td align="right"></td></tr><tr><td align="left" port="university"><font color="#0F172A"><b>university</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    hr_staffs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#1E293B" align="center"><font color="#FFFFFF"><b>HR_STAFFS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#DC2626"><b>PK, FK</b></font></td></tr><tr><td align="left" port="company_name"><font color="#0F172A"><b>company_name</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="department"><font color="#0F172A"><b>department</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="position"><font color="#0F172A"><b>position</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    admins [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#1E293B" align="center"><font color="#FFFFFF"><b>ADMINS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#DC2626"><b>PK, FK</b></font></td></tr><tr><td align="left" port="department"><font color="#0F172A"><b>department</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="governance_scope"><font color="#0F172A"><b>governance_scope</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="managed_region"><font color="#0F172A"><b>managed_region</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="position"><font color="#0F172A"><b>position</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    password_resets [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#1E293B" align="center"><font color="#FFFFFF"><b>PASSWORD_RESETS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="email"><font color="#0F172A"><b>email</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="expires_at"><font color="#0F172A"><b>expires_at</b>*</font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="token"><font color="#0F172A"><b>token</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
    audit_logs [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="4" style="rounded" bgcolor="#FFFFFF" color="#CBD5E1"><tr><td colspan="3" bgcolor="#1E293B" align="center"><font color="#FFFFFF"><b>AUDIT_LOGS</b></font></td></tr><tr><td align="left" port="id"><font color="#0F172A"><b>id</b>*</font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#D97706"><b>PK</b></font></td></tr><tr><td align="left" port="user_id"><font color="#0F172A"><b>user_id</b></font></td><td align="left"><font color="#64748B">INT</font></td><td align="right"><font color="#2563EB"><b>FK</b></font></td></tr><tr><td align="left" port="action"><font color="#0F172A"><b>action</b>*</font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="created_at"><font color="#0F172A"><b>created_at</b></font></td><td align="left"><font color="#64748B">DATETIME</font></td><td align="right"></td></tr><tr><td align="left" port="details"><font color="#0F172A"><b>details</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="ip_address"><font color="#0F172A"><b>ip_address</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr><tr><td align="left" port="target"><font color="#0F172A"><b>target</b></font></td><td align="left"><font color="#64748B">VARCHAR</font></td><td align="right"></td></tr></table>>];
