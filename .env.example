# ==========================================
# Automated Resume Analysis System (.env)
# ==========================================

# --- PostgreSQL Database ---
DB_USER=postgres
DB_PASSWORD=passwordnamin
DB_HOST=db
DB_PORT=5432
DB_NAME=automated_resume_db
DATABASE_URL=postgresql+asyncpg://postgres:passwordnamin@db:5432/automated_resume_db

# --- Redis Broker & Cache ---
REDIS_URL=redis://redis:6379/0

# --- Security / JWT ---
SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80
# Public URL used to build Google OAuth callbacks. Use your named Cloudflare
# tunnel/custom domain here for a stable Google redirect URI.
PUBLIC_BASE_URL=
VITE_API_URL=/api
VITE_WS_URL=
HTTP_PORT=8080
AUTO_SEED_DEMO_DATA=true

# --- Cloudflare Tunnel & Custom Domain ---
# For your purchased domain (e.g. mariwasa.bid):
CUSTOM_DOMAIN=mariwasa.bid
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Default creates a temporary trycloudflare.com URL if CUSTOM_DOMAIN is empty.
CLOUDFLARE_TUNNEL_COMMAND=tunnel --no-autoupdate --url http://frontend:80

# --- Email Configuration (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ceramicsmariwasasiam@gmail.com
SMTP_PASSWORD=your_smtp_password

# --- Gemini AI API Configuration (Primary-First Failover Pool) ---
# Comma-separated ordered pool of Gemini API keys (first key is used as primary by default).
# Alternatively, set GEMINI_API_KEY (primary) plus GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
GEMINI_API_KEYS=your_gemini_api_keys
# GEMINI_API_KEY=your_primary_gemini_api_key
# GEMINI_API_KEY_2=your_backup_gemini_api_key
# Optional: comma-separated GCP project identifiers aligned with keys so shared-project
# quota cooldowns are respected across keys belonging to the same project.
# GEMINI_API_KEY_PROJECTS=project-primary,project-backup
GEMINI_ENABLED=true
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# Quota-saving strategy knobs:
#   smart      = 0 calls on obvious non-resumes (local pre-filter) + 1 cached Flash-Lite call to verify & enrich
#                valid/borderline docs (auto-downgrades to 'borderline' at >=70% daily budget or degraded pool)
#   borderline = call Gemini ONLY for uncertain/borderline/incomplete docs (lowest quota consumption)
#   off        = pure local deterministic extraction/validation (0 Gemini calls during upload)
GEMINI_RESUME_VERIFY_MODE=smart
GEMINI_LIGHTWEIGHT_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_DAILY_EXTRACTION_BUDGET=150
GEMINI_CACHE_ENABLED=true
GEMINI_EXTRACTION_CACHE_TTL_SECONDS=604800
GEMINI_MATCH_CACHE_TTL_SECONDS=86400
GEMINI_TIMEOUT_SECONDS=30
GEMINI_BASE_COOLDOWN_SECONDS=15
GEMINI_MAX_COOLDOWN_SECONDS=300
GEMINI_QUOTA_COOLDOWN_SECONDS=900
GEMINI_TRANSIENT_COOLDOWN_SECONDS=30
GEMINI_TRANSIENT_FAILURE_THRESHOLD=3
GEMINI_MAX_TRANSIENT_RETRIES=2
GEMINI_MAX_CONCURRENT_REQUESTS=4
GEMINI_REDIS_COOLDOWN_SYNC=true

# --- Google Calendar OAuth 2.0 ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Supabase Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_BUCKET=resume storage
SUPABASE_PROFILE_BUCKET=profile_images
SUPABASE_PROFILE_PATH=profiles
SUPABASE_RESUME_IMAGES_BUCKET=resume_images
SUPABASE_RESUME_IMAGES_PATH=resumeimages

# --- High-Concurrency / Multi-Worker Tuning (500+ Users) ---
WEB_CONCURRENCY=4
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=60
DB_POOL_RECYCLE=1800
CELERY_CONCURRENCY=4

# --- SMS Gateway Configuration (IPROG SMS) ---
SMS_PROVIDER=iprogsms
IPROG_SMS_API_URL=https://www.iprogsms.com/api/v1/sms_messages
IPROG_SMS_API_TOKEN=your_iprogsms_api_token
IPROG_SMS_PROVIDER=0
# Optional custom sender name approved at https://www.iprogsms.com/sender-names/new
# Required for Smart/TNT numbers (shared sender 'iprogtech' supports Globe, TM, DITO, and GOMO).
# IPROG_SMS_SENDER_NAME=
