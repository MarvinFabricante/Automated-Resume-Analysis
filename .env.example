# ==========================================
# Automated Resume Analysis System (.env)
# ==========================================

# --- PostgreSQL Database ---
DB_USER=postgres
DB_PASSWORD=passwordnamin
DB_HOST=db
DB_PORT=5432
DB_NAME=automated_resume_db
DATABASE_URL=postgresql+asyncpg://postgres:passwordnamin@db:5432/automated_resume_db

# --- Redis Broker & Cache ---
REDIS_URL=redis://redis:6379/0

# --- Security / JWT ---
SECRET_KEY=supersecretkey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80
VITE_API_URL=/api
VITE_WS_URL=
HTTP_PORT=8080
AUTO_SEED_DEMO_DATA=true

# --- Cloudflare Tunnel ---
# Default creates a temporary trycloudflare.com URL.
# For a named tunnel, set this to:
# CLOUDFLARE_TUNNEL_COMMAND=tunnel --no-autoupdate run --token your_cloudflare_tunnel_token
CLOUDFLARE_TUNNEL_COMMAND=tunnel --no-autoupdate --url http://frontend:80

# --- Email Configuration (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ceramicsmariwasasiam@gmail.com
SMTP_PASSWORD=your_smtp_password

# --- Gemini AI API Keys (comma-separated rotation pool) ---
GEMINI_API_KEYS=your_gemini_api_keys

# --- Google Calendar OAuth 2.0 ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Supabase Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_BUCKET=resume storage
